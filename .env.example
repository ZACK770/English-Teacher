# Never commit the real values. Generate each secret independently.
GEMINI_API_KEY=replace-with-google-ai-studio-api-key
TECHNOLINE_BEARER_SECRET=replace-with-at-least-32-random-characters
ADMIN_BEARER_SECRET=replace-with-a-different-32-character-secret

# This is the channel identifier shown by Technoline, not the Bearer secret.
TECHNOLINE_CHANNEL_ID=2614d922d06b4f
TECHNOLINE_RETURN_EXTENSION=/

# Optional hardening after Technoline supplies its outbound CIDR ranges.
# JSON syntax is accepted by pydantic-settings, for example ["203.0.113.0/24"]
TECHNOLINE_ALLOWED_IPS=[]

GEMINI_LIVE_MODEL=models/gemini-3.8-live
GEMINI_VOICE=Aoede
GEMINI_LANGUAGE_CODE=en-US
GEMINI_VAD_SILENCE_MS=250
GEMINI_VAD_PREFIX_MS=160
GEMINI_INPUT_BATCH_FRAMES=5
STUDENT_ID=student
DATABASE_PATH=data/progress.db
MAX_CALL_MINUTES=30
MAX_CONCURRENT_CALLS=2
STORE_TRANSCRIPTS=false
LOG_LEVEL=INFO

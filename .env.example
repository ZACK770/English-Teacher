# Never commit real secret values.
GEMINI_API_KEY=replace-with-google-ai-studio-api-key
ADMIN_BEARER_SECRET=replace-with-a-different-32-character-secret

# Technoline authentication is disabled by default. Leave both values as-is.
TECHNOLINE_ENFORCE_BEARER=false
# TECHNOLINE_BEARER_SECRET=replace-with-at-least-32-random-characters

# This is the channel identifier shown by Technoline, not a secret.
TECHNOLINE_CHANNEL_ID=2614d922d06b4f
# Optional second raw channel for the independent adult tutor profile.
# TECHNOLINE_ADULT_CHANNEL_ID=replace-with-second-technoline-channel-id
TECHNOLINE_RETURN_EXTENSION=/

# Optional hardening after Technoline supplies its outbound CIDR ranges.
# JSON syntax is accepted by pydantic-settings, for example ["203.0.113.0/24"]
TECHNOLINE_ALLOWED_IPS=[]

GEMINI_LIVE_MODEL=models/gemini-3.8-live
GEMINI_VOICE=Aoede
GEMINI_LANGUAGE_CODE=he-IL
# Low start sensitivity prevents breaths and brief room noise from interrupting the tutor.
GEMINI_VAD_START_SENSITIVITY=START_SENSITIVITY_LOW
GEMINI_VAD_END_SENSITIVITY=END_SENSITIVITY_LOW
GEMINI_VAD_SILENCE_MS=700
GEMINI_VAD_PREFIX_MS=400
GEMINI_INPUT_BATCH_FRAMES=5
STUDENT_ID=student
ADULT_STUDENT_ID=adult
DATABASE_PATH=data/progress.db
MAX_CALL_MINUTES=30
MAX_CONCURRENT_CALLS=2
STORE_TRANSCRIPTS=false
LOG_LEVEL=INFO
